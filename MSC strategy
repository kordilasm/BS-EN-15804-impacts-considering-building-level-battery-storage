def simulate_battery_storage_full(needs_df, battery_capacity, return_soc=False, initial_soc_kwh=None):
    if battery_capacity is None or battery_capacity == 0:
        grid_import_no_battery = calculate_net_grid_import_without_battery(needs_df)
        return (pd.Series(grid_import_no_battery), 0,
                calculate_exports_without_battery(needs_df))

    df = needs_df.copy()
    df["load_kWh"] = df.iloc[:, 0:5].sum(axis=1)
    df["pv_kWh"]   = -df.iloc[:, 5]
    generation     = df["pv_kWh"]

    Rbat        = BATTERY_EFFICIENCY
    DODbat      = BATTERY_DOD
    single_eff  = (Rbat ** 0.5)
    max_power   = battery_capacity / BATTERY_DURATION_H
    min_soc     = (1 - DODbat) * battery_capacity
    initial_soc = 0.5 * battery_capacity
    if initial_soc_kwh is not None:
        initial_soc = initial_soc_kwh
    usable_capacity = battery_capacity - min_soc

    soc = initial_soc
    soc_list, charge_list, discharge_list, grid_import_list = [], [], [], []
    export_list = []
    cumulative_throughput = 0

    for load, gen in zip(df["load_kWh"], generation):
        net_energy = gen - load
        if net_energy > 0:
            max_charge_possible = min(max_power, (battery_capacity - soc) / single_eff)
            charge_energy = min(net_energy, max_charge_possible)
            actual_charge = charge_energy * single_eff
            soc += actual_charge
            energy_used_for_charging = charge_energy
            remaining_surplus = net_energy - energy_used_for_charging
            export_kWh  = remaining_surplus
            grid_import = 0
            discharge   = 0.0
            charge      = charge_energy
            cumulative_throughput += charge_energy
        else:
            shortfall   = -net_energy
            available_energy = max(0.0, soc - min_soc)
            max_discharge_possible = min(max_power, available_energy * single_eff)
            discharge_energy = min(shortfall, max_discharge_possible)
            actual_discharge = discharge_energy / single_eff
            soc -= actual_discharge
            remaining_deficit = shortfall - discharge_energy
            grid_import = remaining_deficit if remaining_deficit > 0 else 0
            export_kWh  = 0.0
            charge      = 0.0
            discharge   = discharge_energy
            cumulative_throughput += discharge_energy

        soc = min(max(soc, min_soc), battery_capacity)
        soc_list.append(soc)
        charge_list.append(charge)
        discharge_list.append(discharge)
        grid_import_list.append(grid_import)
        export_list.append(export_kWh)

    annual_cycle_count = 0.5 * cumulative_throughput / usable_capacity if usable_capacity > 0 else 0
    if return_soc:
        idle = [(ch <= STANDBY_IDLE_TOL_KWH and dis <= STANDBY_IDLE_TOL_KWH)
                for ch, dis in zip(charge_list, discharge_list)]
        return pd.Series(grid_import_list), annual_cycle_count, pd.Series(export_list), soc_list, idle
    return pd.Series(grid_import_list), annual_cycle_count, pd.Series(export_list)


def simulate_battery_storage(needs_df, battery_capacity):
    grid_import, cycles, _ = simulate_battery_storage_full(needs_df, battery_capacity)
    return grid_import, cycles


_fade_cache = {}


def simulate_60years_with_fade(needs_periods, capacity, weather_key):
    key = (weather_key, round(float(capacity), 9), BATTERY_CHEMISTRY, FADE_MODEL_CLASS, FADE_SCALAR, FADE_EOL,
           BATTERY_EFFICIENCY)
    if key in _fade_cache:
        return _fade_cache[key]
    fade = BatteryFade()
    imports, cycles, exports = [], [], []
    carried = None
    for y in range(HORIZON_YEARS):
        q = fade.begin_year(y)
        if len(needs_periods) == 1 or y < 26:
            needs_y = needs_periods[0]
        elif y < 56:
            needs_y = needs_periods[1]
        else:
            needs_y = needs_periods[2]
        start = fade.start_energy(capacity * q, carried)
        grid_import, annual_cycles, export, soc, idle = simulate_battery_storage_full(
            needs_y, capacity * q, return_soc=True, initial_soc_kwh=start)
        fade.end_year(y, np.asarray(soc, dtype=float) / (capacity * q), annual_cycles,
                      start_fraction=start / (capacity * q))
        carried = float(soc[-1])
        grid_import, export, standby = apply_standby(grid_import, export, idle)
        fade.rows[-1].extend(standby)
        imports.append(grid_import); cycles.append(annual_cycles); exports.append(export)
    fade.finish()
    result = {'imports': imports, 'cycles': cycles, 'exports': exports,
              'installs': fade.installs, 'rows': fade.rows}
    _fade_cache[key] = result
    return result


