def safe_load_needs(needs_file, sheet_name):
    tmp_df = pd.read_excel(needs_file, sheet_name=sheet_name, engine="openpyxl")
    expected_cols = ['B', 'C', 'D', 'E', 'F', 'H']
    col_indices = [column_index_from_string(c) - 1 for c in expected_cols]
    if max(col_indices) >= len(tmp_df.columns):
        raise ValueError(f"{needs_file} [{sheet_name}] has {len(tmp_df.columns)} columns, expected at least {max(col_indices) + 1}")
    out = pd.concat([tmp_df.iloc[:, idx] for idx in col_indices], axis=1).apply(pd.to_numeric, errors='coerce').iloc[:HOURS_PER_YEAR]
    if len(out) < HOURS_PER_YEAR:
        raise ValueError(f"{needs_file} [{sheet_name}] has {len(out)} rows, expected {HOURS_PER_YEAR}")
    if out.isna().any().any():
        raise ValueError(f"{needs_file} [{sheet_name}] contains non-numeric or empty cells in columns {expected_cols}")
    return out


def calculate_net_grid_import_without_battery(needs_df):
    consumption_kWh = needs_df.iloc[:, 0:5].copy()
    total_load      = consumption_kWh.sum(axis=1)
    pv_generation   = -needs_df.iloc[:, 5]
    net_grid_import = total_load - np.minimum(pv_generation, total_load)
    return net_grid_import


