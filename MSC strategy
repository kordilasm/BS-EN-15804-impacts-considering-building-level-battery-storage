                eol = float(entry) / 100
                if 0 < eol < 1:
                    break
            except ValueError:
                pass
        runs.append({'tag': f"S2_EOL{eol * 100:g}", 'scalar': 1.0, 'eol': eol, 'sensitivity': True})
    if "4" in picks:
        runs.append({'tag': f"S3_eff{FADE_S3_EFFICIENCY * 100:g}", 'scalar': 1.0, 'eol': FADE_EOL_DEFAULT,
                     'sensitivity': True, 'efficiency': FADE_S3_EFFICIENCY})
