def _get_future_module_per_kg(year: int, scenario: str, module: str) -> dict:
    key = (year, scenario, module)
    if key in _future_impacts_cache:
        return _future_impacts_cache[key]
    result_df = _battery_future_calculator.run_calculation(
        option=1, target_year=year, scenario=scenario, use_eu_for_eu=False,
        simapro_filename=f"SimaPro impacts_{module}.xlsx",
