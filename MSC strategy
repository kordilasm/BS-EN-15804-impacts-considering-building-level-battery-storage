def run_current_weather(run_suffix, combos, output_labels):
    cycle_counts_current     = {}
    all_test_results_current = {}
    fade_current             = {}
    needs_current      = safe_load_needs(needs_file_current, "current")
    avg_demand_current = calculate_avg_demand(needs_current)

    current_results          = {}
    module_d_results_current = {}

    scenarios_to_process = [s for s in scenario_files.keys() if (s, "current") in combos]

    for scenario in scenarios_to_process:
        impacts_df = load_impacts_for_scenario(scenario)

        if use_battery and not basic_strategy_test_capacities:
            fr = simulate_60years_with_fade((needs_current,), battery_capacity_input, "current")
            fade_current[scenario] = fr
            cycle_counts_current[scenario] = float(np.mean(fr['cycles']))
            current_results[scenario] = calculate_impacts_by_year(fr['imports'], impacts_df)
            module_d_results_current[scenario] = calculate_module_d_by_year(fr['exports'], impacts_df)
            continue

        if use_battery and basic_strategy_test_capacities:
            all_test_results = basic_strategy_multiple_capacities(needs_current, avg_demand_current)
            all_test_results_current[scenario] = all_test_results
            grid_import_current, total_cycle_count = get_battery_adjusted_grid_import(
                needs_current, battery_choice=battery_choice, battery_capacity=0)
        else:
            grid_import_current, total_cycle_count = get_battery_adjusted_grid_import(
                needs_current, battery_choice=battery_choice, battery_capacity=battery_capacity_input)

        cycle_counts_current[scenario] = total_cycle_count

        if len(grid_import_current) != HOURS_PER_YEAR:
            if len(grid_import_current) > HOURS_PER_YEAR:
                grid_import_current = grid_import_current.iloc[:HOURS_PER_YEAR]
            else:
                grid_import_current = grid_import_current.reindex(range(HOURS_PER_YEAR), fill_value=0)

        operational_results = calculate_current_impacts(grid_import_current, impacts_df)
        current_results[scenario] = operational_results

        if not (use_battery and basic_strategy_test_capacities):
            exports_current = calculate_exports_without_battery(needs_current)
            module_d_results_current[scenario] = calculate_module_d_current(exports_current, impacts_df)

    output_current = os.path.join(OUTPUT_FOLDER, f"impact_results_current_weather{chem_suffix}{run_suffix}.xlsx")
    with pd.ExcelWriter(output_current, engine="openpyxl") as writer:

        if use_battery and basic_strategy_test_capacities and all_test_results_current:
            for scenario in scenarios_to_process:
                if scenario not in all_test_results_current:
                    continue
                impacts_df = load_impacts_for_scenario(scenario)
                all_data   = []

                for test_num in range(25):
                    test_data    = all_test_results_current[scenario][test_num]
                    capacity     = test_data['capacity_kWh']
                    hours        = test_data['hours']
                    grid_imports = test_data['grid_imports']

                    if 'installs' in test_data:
                        operational_impacts = calculate_impacts_by_year(grid_imports, impacts_df)
                        module_d_values     = calculate_module_d_by_year(test_data['exports'], impacts_df)
                    else:
                        operational_impacts = calculate_current_impacts(grid_imports, impacts_df)
                        module_d_values     = calculate_module_d_current(test_data['exports'], impacts_df)

                    annual_cycles  = test_data['annual_cycles']
                    cycles_by_year = test_data.get('cycles_by_year', [annual_cycles] * 60)
                    if capacity > 0:
                        installs, cycle_cols = _schedule_columns(cycles_by_year, CYCLE_YEARS,
                                                                 test_data.get('installs'))
                    else:
                        installs, cycle_cols = None, [0, ""] + [0] * len(CYCLE_YEARS)

                    all_data.append([
                        f"{hours:.0f} hours ({capacity:.1f} kWh)",
                        "Impact Category",
                        "Operational Impact (60 years)",
                        "Embodied Impact (60 years)",
                        "A1-A3 (60 years)",
                        "A4 (60 years)",
                        "B4 (60 years)",
                        "C (60 years)",
                        "D (60 years)",
                        "Batteries needed", "Replacement years", *[f"Cycles {y}" for y in CYCLE_YEARS],
                    ])

                    for label in output_labels:
                        operational_value = operational_impacts[label]

                        if capacity > 0:
                            battery_mass = capacity * BATTERY_KG_PER_KWH
                            mods = calculate_embodied_impacts(
                                battery_mass, scenario, install_times=installs,
                                inverter_kw=capacity / BATTERY_DURATION_H)

                            embodied_value = mods['total'][label]
                            a1a3_value     = mods['A1A3'][label]
                            a4_value       = mods['A4'][label]
                            b4_value       = mods['B4'][label]
                            c_value        = mods['C'][label]
                        else:
                            embodied_value = 0
                            a1a3_value     = 0
                            a4_value       = 0
                            b4_value       = 0
                            c_value        = 0

                        all_data.append([
                            "", label,
                            operational_value,
                            embodied_value,
                            a1a3_value,
                            a4_value,
                            b4_value,
                            c_value,
                            module_d_values[label],
                        ] + cycle_cols)

                    all_data.append([""] * (11 + len(CYCLE_YEARS)))

                df_all_tests = pd.DataFrame(all_data, columns=[
                    'Capacity',
                    'Impact Category',
                    'Operational Impact (60 years)',
                    'Embodied Impact (60 years)',
                    'A1-A3 (60 years)',
                    'A4 (60 years)',
                    'B4 (60 years)',
                    'C (60 years)',
                    'D (60 years)',
                    "Batteries needed",
                    "Replacement years",
                    *[f"Cycles {y}" for y in CYCLE_YEARS],
                ])
                df_all_tests.to_excel(writer, sheet_name=scenario, index=False)

        else:
            for scenario in current_results.keys():
                capacity_to_use = battery_capacity_input if use_battery else None
                fr = fade_current.get(scenario)
                df_operational = _build_single_result_df(
                    current_results[scenario],
                    capacity_to_use,
                    fr['cycles'] if fr else [cycle_counts_current[scenario]] * 60,
                    scenario,
                    battery_choice,
                    module_d_results_current.get(scenario),
                    installs=fr['installs'] if fr else None,
                )
                if len(output_labels) != len(labels):
                    df_operational = df_operational.loc[output_labels]
                df_operational.to_excel(writer, sheet_name=scenario)

    return output_current


def run_future_weather(run_suffix, combos, output_labels):
    cycles_by_year_med  = {}
    cycles_by_year_high = {}
    installs_med        = {}
    installs_high       = {}
    sweep_med           = {}
    sweep_high          = {}
    needs_2020s_med,  needs_2050s_med,  needs_2080s_med  = (
        safe_load_needs(needs_file_future, "2020s medium"),
        safe_load_needs(needs_file_future, "2050s medium"),
        safe_load_needs(needs_file_future, "2080s medium")
    )
    needs_2020s_high, needs_2050s_high, needs_2080s_high = (
        safe_load_needs(needs_file_future, "2020s high"),
        safe_load_needs(needs_file_future, "2050s high"),
        safe_load_needs(needs_file_future, "2080s high")
    )

    future_results_med    = {}
    future_results_high   = {}
    module_d_results_med  = {}
    module_d_results_high = {}

    for scenario in scenario_files.keys():
        if (scenario, "medium") not in combos and (scenario, "high") not in combos:
            continue
        impacts_df = load_impacts_for_scenario(scenario)
        cycles_by_year_med[scenario]  = [0] * 60
        cycles_by_year_high[scenario] = [0] * 60

        if use_battery and not basic_strategy_test_capacities:
            for weather_key, needs_periods, results, module_d, cycles, installs in (
                    ("medium", (needs_2020s_med, needs_2050s_med, needs_2080s_med),
                     future_results_med, module_d_results_med, cycles_by_year_med, installs_med),
                    ("high", (needs_2020s_high, needs_2050s_high, needs_2080s_high),
                     future_results_high, module_d_results_high, cycles_by_year_high, installs_high)):
                if (scenario, weather_key) not in combos:
                    continue
                fr = simulate_60years_with_fade(needs_periods, battery_capacity_input, weather_key)
                results[scenario]  = calculate_impacts_by_year(fr['imports'], impacts_df, future=True)
                module_d[scenario] = calculate_module_d_by_year(fr['exports'], impacts_df, future=True)
                cycles[scenario]   = fr['cycles']
                installs[scenario] = fr['installs']
            continue

        if use_battery:
            for weather_key, needs_periods, sweeps in (
                    ("medium", (needs_2020s_med, needs_2050s_med, needs_2080s_med), sweep_med),
                    ("high", (needs_2020s_high, needs_2050s_high, needs_2080s_high), sweep_high)):
                if (scenario, weather_key) not in combos:
                    continue
                sweeps[scenario] = basic_strategy_multiple_capacities_future(
                    needs_periods, calculate_avg_demand(needs_periods[0]), weather_key)

        else:
            grid_import_2020s_med  = calculate_net_grid_import_without_battery(needs_2020s_med)
            grid_import_2050s_med  = calculate_net_grid_import_without_battery(needs_2050s_med)
            grid_import_2080s_med  = calculate_net_grid_import_without_battery(needs_2080s_med)
            future_results_med[scenario] = calculate_future_impacts(
                grid_import_2020s_med, grid_import_2050s_med, grid_import_2080s_med, impacts_df)
            module_d_results_med[scenario] = calculate_module_d_future(
                calculate_exports_without_battery(needs_2020s_med),
                calculate_exports_without_battery(needs_2050s_med),
                calculate_exports_without_battery(needs_2080s_med), impacts_df)

            grid_import_2020s_high = calculate_net_grid_import_without_battery(needs_2020s_high)
            grid_import_2050s_high = calculate_net_grid_import_without_battery(needs_2050s_high)
            grid_import_2080s_high = calculate_net_grid_import_without_battery(needs_2080s_high)
            future_results_high[scenario] = calculate_future_impacts(
                grid_import_2020s_high, grid_import_2050s_high, grid_import_2080s_high, impacts_df)
            module_d_results_high[scenario] = calculate_module_d_future(
                calculate_exports_without_battery(needs_2020s_high),
                calculate_exports_without_battery(needs_2050s_high),
                calculate_exports_without_battery(needs_2080s_high), impacts_df)

    output_future = os.path.join(OUTPUT_FOLDER, f"impact_results_future{chem_suffix}{run_suffix}.xlsx")
    with pd.ExcelWriter(output_future, engine="openpyxl") as writer:

        for sheet_suffix, sweeps in (("_MEDIUM", sweep_med), ("_HIGH", sweep_high)):
            for scenario, tests in sweeps.items():
                _write_future_sweep_sheet(writer, scenario, scenario + sheet_suffix, tests, output_labels)

        for scenario in future_results_med.keys():
            if (scenario, "medium") not in combos:
                continue
            capacity_to_use = battery_capacity_input if use_battery else None
            df_operational = _build_single_result_df(
                future_results_med[scenario],
                capacity_to_use,
                cycles_by_year_med[scenario],
                scenario,
                battery_choice,
                module_d_results_med.get(scenario),
                CYCLE_YEARS_FUT,
                installs=installs_med.get(scenario),
            )
            if len(output_labels) != len(labels):
                df_operational = df_operational.loc[output_labels]
            df_operational.to_excel(writer, sheet_name=scenario + "_MEDIUM")

        for scenario in future_results_high.keys():
            if (scenario, "high") not in combos:
                continue
            capacity_to_use = battery_capacity_input if use_battery else None
            df_operational = _build_single_result_df(
                future_results_high[scenario],
                capacity_to_use,
                cycles_by_year_high[scenario],
                scenario,
                battery_choice,
                module_d_results_high.get(scenario),
                CYCLE_YEARS_FUT,
                installs=installs_high.get(scenario),
            )
            if len(output_labels) != len(labels):
                df_operational = df_operational.loc[output_labels]
            df_operational.to_excel(writer, sheet_name=scenario + "_HIGH")
    return output_future


