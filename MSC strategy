            else:
                factors = repeated
            total += (series_by_year[y].reset_index(drop=True).to_numpy() * factors).sum()
        results[label] = total
    return results


def calculate_module_d_by_year(exports_by_year, impacts_df, future=False):
    d = calculate_impacts_by_year(exports_by_year, impacts_df, future)
    return {label: -value for label, value in d.items()}


def load_impacts_for_scenario(scenario):
    impacts_file = os.path.join(base_path, scenario_files[scenario])
    impact_cols  = list(string.ascii_uppercase[1:26])
    impacts_df   = pd.read_excel(impacts_file, sheet_name="Sheet1", usecols=",".join(impact_cols), engine="openpyxl")
    impacts_df = impacts_df.apply(pd.to_numeric, errors='coerce')
    if impacts_df.isna().any().any():
        raise ValueError(f"{impacts_file} contains non-numeric or empty cells")
    return impacts_df


def calculate_exports_without_battery(needs_df):
    df = needs_df.copy()
    load_kWh   = df.iloc[:, 0:5].sum(axis=1)
    generation = -df.iloc[:, 5]
    return np.maximum(generation - load_kWh, 0).reset_index(drop=True)


def calculate_module_d_current(exports, impacts_df):
    d = calculate_current_impacts(exports, impacts_df)
    return {label: -value for label, value in d.items()}


def calculate_module_d_future(exports_2020s, exports_2050s, exports_2080s, impacts_df):
    d = calculate_future_impacts(exports_2020s, exports_2050s, exports_2080s, impacts_df)
    return {label: -value for label, value in d.items()}


def _schedule_columns(cycles_by_year, cycle_years, installs):
    repl = "; ".join(str(round(STUDY_START_YEAR + t)) for t in installs[1:]) or "none"
    yearly = [cycles_by_year[min(y - STUDY_START_YEAR, len(cycles_by_year) - 1)] for y in cycle_years]
    return installs, [len(installs), repl] + yearly


def _build_single_result_df(operational_results, capacity_to_use, cycles_by_year, scenario,
                             battery_choice, module_d_results=None, cycle_years=CYCLE_YEARS,
                             installs=None):
    df = pd.DataFrame({
        'Operational Impact (60 years)': pd.Series(operational_results)
    })

    cycle_cols_names = [f"Cycles {y}" for y in cycle_years]

    has_battery = (
        battery_choice > 1 and
        capacity_to_use is not None and
        capacity_to_use > 0
    )

    if has_battery:
        battery_mass = capacity_to_use * BATTERY_KG_PER_KWH
        installs, sched_cols = _schedule_columns(cycles_by_year, cycle_years, installs)
        embodied_modules = calculate_embodied_impacts(
            battery_mass, scenario, install_times=installs,
            inverter_kw=capacity_to_use / BATTERY_DURATION_H)

        df['Embodied Impact (60 years)'] = pd.Series(embodied_modules['total'])
        df['A1-A3 (60 years)']           = pd.Series(embodied_modules['A1A3'])
        df['A4 (60 years)']              = pd.Series(embodied_modules['A4'])
        df['B4 (60 years)']              = pd.Series(embodied_modules['B4'])
        df['C (60 years)']               = pd.Series(embodied_modules['C'])
    else:
        df['Embodied Impact (60 years)']  = 0.0
        df['A1-A3 (60 years)']            = 0.0
        df['A4 (60 years)']               = 0.0
        df['B4 (60 years)']               = 0.0
        df['C (60 years)']                = 0.0
        sched_cols = [0, ""] + [0] * len(cycle_years)

    if module_d_results is not None:
        df['D (60 years)'] = pd.Series(module_d_results)
    df['Batteries needed']   = sched_cols[0]
    df['Replacement years']  = sched_cols[1]
    for name, val in zip(cycle_cols_names, sched_cols[2:]):
        df[name] = val

    return df


def get_scenario_selection():
    print("\nSelect electricity scenario(s):")
    for idx, s in enumerate(["BASELINE", "FS", "ST", "CT", "LW", "ALL SCENARIOS"], 1):
        print(f"{idx}. {s}")
    print("\nYou can enter multiple numbers separated by commas (e.g., 1,3,5)")

    all_scenarios = ["BASELINE", "FS", "ST", "CT", "LW"]

    while True:
        try:
            user_input = input("Enter selection(s): ").strip()
            if user_input == "6":
                return "ALL", all_scenarios.copy()
            selections = [s.strip() for s in user_input.split(",")]
            chosen = []
            valid  = True
            for sel in selections:
                if not sel.isdigit() or not (1 <= int(sel) <= 5):
                    valid = False
                    break
                name = all_scenarios[int(sel) - 1]
                if name not in chosen:
                    chosen.append(name)
            if valid and chosen:
                label = chosen[0] if len(chosen) == 1 else f"SELECTED_{len(chosen)}"
                return label, chosen
        except ValueError:
            pass


def get_weather_choice():
    while True:
        print("\nSelect weather case(s):")
        print("1. Current weather")
        print("2. Future weather (MEDIUM and/or HIGH)")
        print("3. Current and future weather")
        choice = input("Enter choice (1-3): ").strip()
        if choice in ("1", "2", "3"):
            break
    if choice == "1":
        return ["current"]
    future = {"1": ["medium"], "2": ["high"], "3": ["medium", "high"]}
    while True:
        print("\nSelect future weather:")
        print("1. MEDIUM")
        print("2. HIGH")
        print("3. MEDIUM and HIGH")
        sub = input("Enter choice (1-3): ").strip()
        if sub in future:
            break
    return (["current"] if choice == "3" else []) + future[sub]


