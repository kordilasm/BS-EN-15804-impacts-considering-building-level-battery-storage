def calculate_current_impacts(grid_imports, impacts_df):
    results = {}
    years_variable = 26
    years_repeated = 34

    slice_variable_impacts = slice(0, HOURS_PER_YEAR * years_variable)
    slice_repeated_impacts = slice(
        HOURS_PER_YEAR * (years_variable - 1),
        HOURS_PER_YEAR * years_variable
    )

    grid_import_repeated = pd.concat(
        [grid_imports.reset_index(drop=True)] * years_variable,
        ignore_index=True
    )

    for i, label in enumerate(labels):

        impacts_variable = (
            impacts_df.iloc[slice_variable_impacts, i]
            .reset_index(drop=True)
        )

        min_length = min(
            len(grid_import_repeated),
            len(impacts_variable)
        )

        col_sum_variable = (
            grid_import_repeated.iloc[:min_length].to_numpy()
            * impacts_variable.iloc[:min_length].to_numpy()
        ).sum()

        col_sum_repeated = (
            grid_imports.reset_index(drop=True).to_numpy()
            * impacts_df.iloc[slice_repeated_impacts, i]
              .reset_index(drop=True).to_numpy()
        ).sum() * years_repeated

        results[label] = col_sum_variable + col_sum_repeated

    return results


def calculate_future_impacts(grid_imports_2020s, grid_imports_2050s, grid_imports_2080s, impacts_df):
