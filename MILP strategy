def calculate_current_impacts(grid_imports, impacts_df):
    results = {}
    years_variable = 26
    years_repeated = 34

    slice_variable_impacts = slice(0, HOURS_PER_YEAR * years_variable)
    slice_repeated_impacts = slice(
        HOURS_PER_YEAR * (years_variable - 1),
        HOURS_PER_YEAR * years_variable
    )

    grid_import_repeated = pd.concat(
        [grid_imports.reset_index(drop=True)] * years_variable,
        ignore_index=True
    )

    for i, label in enumerate(labels):
        impacts_variable = (
            impacts_df.iloc[slice_variable_impacts, i]
            .reset_index(drop=True)
        )
        min_length = min(len(grid_import_repeated), len(impacts_variable))
        col_sum_variable = (
            grid_import_repeated.iloc[:min_length].to_numpy()
            * impacts_variable.iloc[:min_length].to_numpy()
        ).sum()
        col_sum_repeated = (
            grid_imports.reset_index(drop=True).to_numpy()
            * impacts_df.iloc[slice_repeated_impacts, i]
              .reset_index(drop=True).to_numpy()
        ).sum() * years_repeated
        results[label] = col_sum_variable + col_sum_repeated

    return results


def calculate_current_impacts_by_year(imports_by_year, impacts_df):
    results = {}
    if len(imports_by_year) == N_VARIABLE_YEARS + N_REPEATED_YEARS:
        for i, label in enumerate(labels):
            total = 0.0
            for y in range(N_VARIABLE_YEARS + N_REPEATED_YEARS):
                yi = min(y, N_VARIABLE_YEARS - 1)
                f = impacts_df.iloc[yi * HOURS_PER_YEAR:(yi + 1) * HOURS_PER_YEAR, i].to_numpy(dtype=float)
                total += float(np.dot(np.asarray(imports_by_year[y], dtype=float), f))
            results[label] = total
        return results
    future = len(imports_by_year) == N_VARIABLE_YEARS + 2
    for i, label in enumerate(labels):
        total = 0.0
        for y in range(N_VARIABLE_YEARS):
            f = impacts_df.iloc[y * HOURS_PER_YEAR:(y + 1) * HOURS_PER_YEAR, i].to_numpy(dtype=float)
            val = float(np.dot(np.asarray(imports_by_year[y], dtype=float), f))
            total += val
            if y == N_VARIABLE_YEARS - 1:
                if future:
                    total += float(np.dot(np.asarray(imports_by_year[N_VARIABLE_YEARS], dtype=float), f)) * N_YEARS_2050S
                    total += float(np.dot(np.asarray(imports_by_year[N_VARIABLE_YEARS + 1], dtype=float), f)) * N_YEARS_2080S
                else:
                    total += val * N_REPEATED_YEARS
        results[label] = total
    return results


def calculate_exports_without_battery(needs_df):
    df = needs_df.copy()
    load_kWh   = df.iloc[:, 0:5].sum(axis=1)
    generation = -df.iloc[:, 5]
    return np.maximum(generation - load_kWh, 0).reset_index(drop=True)


def calculate_module_d_by_year(exports_by_year, impacts_df):
    d = calculate_current_impacts_by_year(exports_by_year, impacts_df)
    return {label: -value for label, value in d.items()}


def calculate_operational_impact_1year(grid_imports, grid_impacts_data, impact_index):
    impact_factors = grid_impacts_data.iloc[:HOURS_PER_YEAR, impact_index]
    return (grid_imports.reset_index(drop=True).to_numpy() *
            impact_factors.reset_index(drop=True).to_numpy()).sum()


def optimise_year_milp(needs_data, grid_impacts_data, impact_index,
                                                   scenario_type, time_period, use_solver_options,
                                                   battery_capacity, annual_embodied_impact=0,
                                                   return_soc=False, initial_soc_kwh=None):

    if battery_capacity == 0:
        return (pd.Series(calculate_net_grid_import_without_battery(needs_data)), 0,
                calculate_exports_without_battery(needs_data))

    Hbat_dur   = 2
    Rbat        = BATTERY_EFFICIENCY
    DODbat      = BATTERY_DOD
    min_soc     = (1 - DODbat) * battery_capacity
    initial_soc = 0.5 * battery_capacity
    if initial_soc_kwh is not None:
        initial_soc = initial_soc_kwh
    max_power   = battery_capacity / Hbat_dur
    total_hours = HOURS_PER_YEAR
    needs = needs_data
    impact_factors = grid_impacts_data.iloc[:HOURS_PER_YEAR, impact_index]

    model = ConcreteModel()
    model.T = range(total_hours)
    model.charge      = Var(model.T, within=NonNegativeReals, bounds=(0, max_power))
    model.discharge   = Var(model.T, within=NonNegativeReals, bounds=(0, max_power))
    model.soc         = Var(model.T, within=NonNegativeReals, bounds=(min_soc, battery_capacity))
    model.grid_import = Var(model.T, within=NonNegativeReals)
    model.B_ch        = Var(model.T, within=Binary)
    model.B_dis       = Var(model.T, within=Binary)

    model.no_simultaneous = Constraint(
        model.T, rule=lambda m, t: m.B_ch[t] + m.B_dis[t] <= 1)
    model.charge_limit = Constraint(
        model.T, rule=lambda m, t: m.charge[t] <= max_power * m.B_ch[t])
    model.discharge_limit = Constraint(
        model.T, rule=lambda m, t: m.discharge[t] <= max_power * m.B_dis[t])

    single_eff = Rbat ** 0.5

    def soc_dynamics(m, t):
        if t == 0:
            return m.soc[t] == initial_soc + m.charge[t] * single_eff - m.discharge[t] / single_eff
        return m.soc[t] == m.soc[t - 1] + m.charge[t] * single_eff - m.discharge[t] / single_eff
    model.soc_dynamics = Constraint(model.T, rule=soc_dynamics)
    model.soc_lower    = Constraint(model.T, rule=lambda m, t: m.soc[t] >= min_soc)
    model.soc_upper    = Constraint(model.T, rule=lambda m, t: m.soc[t] <= battery_capacity)
    model.final_soc    = Constraint(rule=lambda m: m.soc[total_hours - 1] >= initial_soc)

    def grid_import_constraint(m, t):
        load = (needs.iloc[t, 0] + needs.iloc[t, 1] +
                needs.iloc[t, 2] + needs.iloc[t, 3] + needs.iloc[t, 4])
        pv = -needs.iloc[t, 5]
        return m.grid_import[t] >= load - pv + m.charge[t] - m.discharge[t]
    model.grid_import_def = Constraint(model.T, rule=grid_import_constraint)
    model.grid_import_nn  = Constraint(model.T, rule=lambda m, t: m.grid_import[t] >= 0)

    def integrated_objective(m):
        return sum(m.grid_import[t] * impact_factors.iloc[t] for t in m.T) + annual_embodied_impact
    model.objective = Objective(rule=integrated_objective, sense=minimize)

    solver = SolverFactory('gurobi')
    opts = ({'TimeLimit': 50, 'MIPGap': 0.01, 'Threads': SOLVER_THREADS, 'Presolve': 2, 'Cuts': 2}
            if use_solver_options else
            {'MIPGap': 0.01, 'Threads': SOLVER_THREADS})
    results = solver.solve(model, tee=False, options=opts)

    tc = results.solver.termination_condition
    accepted = (TerminationCondition.optimal, TerminationCondition.feasible,
                TerminationCondition.maxTimeLimit)
    if tc not in accepted or model.grid_import[0].value is None:
        raise RuntimeError(f"Gurobi failed at {battery_capacity:.1f} kWh: {tc}")

    optimized = []
    charges, discharges = [], []
    throughput = 0
    for t in range(total_hours):
        ch  = model.charge[t].value    or 0
        dis = model.discharge[t].value or 0
        throughput += ch + dis
        charges.append(ch)
        discharges.append(dis)
        optimized.append(model.grid_import[t].value or 0)
    usable = battery_capacity - min_soc
    cycles = 0.5 * throughput / usable if usable > 0 else 0

    load_arr = (needs.iloc[:total_hours, 0:3].sum(axis=1)
                + needs.iloc[:total_hours, 3] + needs.iloc[:total_hours, 4]).to_numpy(dtype=float)
    pv_arr   = (-needs.iloc[:total_hours, 5]).to_numpy(dtype=float)
    exports  = np.maximum(pv_arr - load_arr - np.asarray(charges) + np.asarray(discharges), 0)
    if return_soc:
        soc_values = [model.soc[t].value for t in range(total_hours)]
        idle = [(ch <= STANDBY_IDLE_TOL_KWH and dis <= STANDBY_IDLE_TOL_KWH)
                for ch, dis in zip(charges, discharges)]
        return pd.Series(optimized), cycles, pd.Series(exports), soc_values, idle
    return pd.Series(optimized), cycles, pd.Series(exports)


def optimise_all_years_with_fade(needs_data, impacts_df, impact_index, capacity,
                                 use_solver_options, electricity_scenario, extra_needs=None):
    year_dfs = [impacts_df.iloc[y * HOURS_PER_YEAR:(y + 1) * HOURS_PER_YEAR]
                for y in range(N_VARIABLE_YEARS)]
    fade = BatteryFade()
    imports, cycles, exports = [], [], []
    carried = None
    for y in range(HORIZON_YEARS):
        q = fade.begin_year(y)
        if extra_needs is None or y < N_VARIABLE_YEARS:
            needs_y = needs_data
        elif y < N_VARIABLE_YEARS + N_YEARS_2050S:
            needs_y = extra_needs[0]
        else:
            needs_y = extra_needs[1]
        df_y = year_dfs[0] if electricity_scenario == "BASELINE" else year_dfs[min(y, N_VARIABLE_YEARS - 1)]
        period = "current" if extra_needs is None else "future"
        start = fade.start_energy(capacity * q, carried)
        r = optimise_year_milp(
            needs_y, df_y, impact_index, period, period, use_solver_options,
            capacity * q, return_soc=True, initial_soc_kwh=start)
        fade.end_year(y, np.asarray(r[3], dtype=float) / (capacity * q), r[1],
                      start_fraction=start / (capacity * q))
        carried = float(r[3][-1])
        imp, exp, standby = apply_standby(r[0], r[2], r[4])
        fade.rows[-1].extend(standby)
        imports.append(imp); cycles.append(r[1]); exports.append(exp)
    fade.finish()
    return imports, cycles, exports, fade.installs, fade.rows


def optimise_capacity_sweep(needs_data, grid_impacts_data, impact_index,
                                         scenario_type, time_period, use_solver_options,
                                         electricity_scenario, avg_demand, extra_needs=None):

    capacities_to_test = [i * avg_demand for i in range(0, 25)]

    best_capacity     = 0
    best_impact       = float('inf')
    best_grid_imports = None
    best_cycles       = 0.0
    all_test_results  = {}
    period_needs = [needs_data] + (list(extra_needs) if extra_needs is not None else [])
    no_batt_list = [calculate_net_grid_import_without_battery(n) for n in period_needs]
    no_batt_exports_list = [calculate_exports_without_battery(n) for n in period_needs]
    no_batt = no_batt_list[0]
    no_batt_exports = no_batt_exports_list[0]

    for i, test_capacity in enumerate(capacities_to_test):
        hours        = test_capacity / avg_demand
        battery_mass = test_capacity * BATTERY_KG_PER_KWH

        if test_capacity == 0:
            imports_by_year = [no_batt] * N_VARIABLE_YEARS + no_batt_list[1:]
            cycles_by_year  = [0.0] * len(imports_by_year)
            exports_by_year = [no_batt_exports] * N_VARIABLE_YEARS + no_batt_exports_list[1:]
            if extra_needs is not None:
                cycles_by_year = [0.0] * (N_VARIABLE_YEARS + N_YEARS_2050S + N_YEARS_2080S)
            installs, embodied, emb_total = [], None, 0.0
            fade_rows = []
        else:
            imports_by_year, cycles_by_year, exports_by_year, installs, fade_rows = \
                optimise_all_years_with_fade(
                    needs_data, grid_impacts_data, impact_index, test_capacity,
                    use_solver_options, electricity_scenario, extra_needs)
            embodied = calculate_embodied_impacts(
                battery_mass, electricity_scenario, None, install_times=installs,
                inverter_kw=test_capacity / BATTERY_DURATION_H)
            emb_total = embodied['total'][labels[impact_index]]

        operational_all   = calculate_current_impacts_by_year(
            imports_by_year, grid_impacts_data)
        operational_60yrs = operational_all[labels[impact_index]]
        total_impact = operational_60yrs + emb_total
        mean_cycles  = float(np.mean(cycles_by_year))
        module_d = calculate_module_d_by_year(exports_by_year, grid_impacts_data)

        all_test_results[i] = {
            'capacity_kWh':         test_capacity,
            'hours':                hours,
            'operational_all':      operational_all,
            'fade_rows':            fade_rows,
            'annual_cycles':        mean_cycles,
            'cycles_by_year':       cycles_by_year,
            'install_times':        installs,
            'embodied_modules':     embodied,
            'module_d':             module_d,
            'operational_60years':  operational_60yrs,
            'total_impact_60years': total_impact
        }

        if total_impact < best_impact:
            best_impact       = total_impact
            best_capacity     = test_capacity
            best_cycles       = mean_cycles
            best_grid_imports = imports_by_year


    return best_grid_imports, best_cycles, best_capacity, all_test_results


EXCLUDED_IMPACTS = [
    "Ecotoxicity, freshwater - inorganics", "Ecotoxicity, freshwater - organics",
    "Human toxicity, cancer - inorganics",  "Human toxicity, cancer - organics",
    "Human toxicity, non-cancer - inorganics", "Human toxicity, non-cancer - organics"
]


def run_optimisation(electricity_scenario, use_solver_options, weather="current", impact_filter=None):

    excluded_impacts = EXCLUDED_IMPACTS

    impact_indices_to_optimize = [i for i, l in enumerate(labels) if l not in excluded_impacts]
    if impact_filter is not None:
        impact_indices_to_optimize = [i for i in impact_indices_to_optimize if labels[i] in impact_filter]
    impact_labels_to_optimize  = [labels[i] for i in impact_indices_to_optimize]


    if weather == "current":
        needs_current = safe_load_needs(needs_file_current, "current")
        extra_needs   = None
    else:
        needs_current = safe_load_needs(needs_file_future, f"2020s {weather}")
        extra_needs   = (safe_load_needs(needs_file_future, f"2050s {weather}"),
                         safe_load_needs(needs_file_future, f"2080s {weather}"))
    avg_demand_current = calculate_avg_demand(needs_current)
    impacts_df         = load_impacts_for_scenario(electricity_scenario)

    batch_results = {}

    for idx, impact_idx in enumerate(impact_indices_to_optimize):
        label = impact_labels_to_optimize[idx]

        grid_import_current, total_cycle_count, optimal_capacity, all_test_results = \
            optimise_capacity_sweep(
                needs_current, impacts_df, impact_idx,
                weather, weather, use_solver_options,
                electricity_scenario, avg_demand_current, extra_needs
            )

        batch_results[label] = {
            'grid_imports':     grid_import_current,
            'cycles':           total_cycle_count,
            'optimal_capacity': optimal_capacity,
            'all_test_results': all_test_results
        }

    return batch_results, impact_labels_to_optimize, avg_demand_current


