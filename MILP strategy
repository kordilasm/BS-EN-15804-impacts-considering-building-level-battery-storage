def get_fade_runs():
    while True:
        print("\nSelect run(s):")
        print("1. S0 - capacity fade, central settings "
              f"(degradation scalar 1, end of life {FADE_EOL_DEFAULT * 100:.0f}%)")
        print("2. S1 - degradation scalar sensitivity "
              f"({', '.join(f'{1 + s * FADE_SCALAR_STD:.2f}' for s in FADE_S1_SIGMAS)})")
        print("3. S2 - end-of-life capacity sensitivity")
        print(f"4. S3 - round-trip efficiency {FADE_S3_EFFICIENCY * 100:g}% (all chemistries)")
        entry = input("Enter numbers separated by commas (Enter = all): ").strip()
        picks = ["1", "2", "3", "4"] if entry == "" else [p.strip() for p in entry.split(",")]
        if picks and all(p in ("1", "2", "3", "4") for p in picks):
            break

    runs = []
    if "1" in picks:
        runs.append({'tag': "S0", 'scalar': 1.0, 'eol': FADE_EOL_DEFAULT, 'sensitivity': False})
    if "2" in picks:
        for s in FADE_S1_SIGMAS:
            scalar = round(1 + s * FADE_SCALAR_STD, 4)
            runs.append({'tag': f"S1_x{scalar:.2f}", 'scalar': scalar, 'eol': FADE_EOL_DEFAULT,
                         'sensitivity': True})
    if "3" in picks:
        while True:
            entry = input(f"S2 end-of-life capacity in % (Enter = {FADE_S2_EOL_DEFAULT * 100:.0f}): ").strip()
            if entry == "":
                eol = FADE_S2_EOL_DEFAULT
                break
            try:
                eol = float(entry) / 100
                if 0 < eol < 1:
                    break
            except ValueError:
                pass
        runs.append({'tag': f"S2_EOL{eol * 100:g}", 'scalar': 1.0, 'eol': eol, 'sensitivity': True})
    if "4" in picks:
        runs.append({'tag': f"S3_eff{FADE_S3_EFFICIENCY * 100:g}", 'scalar': 1.0, 'eol': FADE_EOL_DEFAULT,
                     'sensitivity': True, 'efficiency': FADE_S3_EFFICIENCY})
    return runs


def _pick_from_list(title, items, show=str):
    while True:
        print(f"\n{title}")
        for i, item in enumerate(items, 1):
            print(f"{i}. {show(item)}")
        entry = input("Enter numbers separated by commas (Enter = all): ").strip()
        if entry == "":
            return list(items)
        picks = [p.strip() for p in entry.split(",")]
        if all(p.isdigit() and 1 <= int(p) <= len(items) for p in picks):
            chosen = []
            for p in picks:
                if items[int(p) - 1] not in chosen:
                    chosen.append(items[int(p) - 1])
            return chosen


def get_sensitivity_scope(scenarios, weather_cases, impact_labels):
    combos = [(s, w) for s in scenarios for w in weather_cases]
    chosen_combos = _pick_from_list(
        "S1/S2/S3: select the scenario / weather combinations", combos, lambda c: f"{c[0]} / {c[1]}")
    chosen_labels = _pick_from_list(
        "S1/S2/S3: select the impact categories", list(impact_labels))
    return chosen_combos, chosen_labels


