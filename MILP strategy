def apply_standby(grid_import, export, idle):
    idle    = np.asarray(idle, dtype=bool)
    standby = np.where(idle, STANDBY_W / 1000.0, 0.0)
    exp     = np.asarray(export, dtype=float)
    from_pv = np.minimum(standby, np.maximum(exp, 0.0))
    from_grid = standby - from_pv
    new_import = pd.Series(np.asarray(grid_import, dtype=float) + from_grid)
    new_export = pd.Series(exp - from_pv)
    return new_import, new_export, [int(idle.sum()), float(standby.sum()),
                                    float(from_pv.sum()), float(from_grid.sum())]


class BatteryFade:

    def __init__(self):
        self.installs = [0.0]
        self.rows     = []
        self._eol_time = None
        self._new_cell()

    def _new_cell(self):
        self.cell = getattr(blast_models, FADE_MODEL_CLASS)(degradation_scalar=FADE_SCALAR)

    def q(self):
        return float(self.cell.outputs['q'][-1])

    def begin_year(self, y):
        t = self._replacement_time(float(y))
        self.new_battery = (y == 0)
        if y > 0 and t is not None:
            self.installs.append(t)
            self._eol_time = None
            self._new_cell()
            self.new_battery = True
        self._q_start = self.q()
        return self._q_start

    def start_energy(self, capacity_y, carried_kwh):
        if self.new_battery or carried_kwh is None:
            return 0.5 * capacity_y
        return min(max(carried_kwh, (1 - BATTERY_DOD) * capacity_y), capacity_y)

    def _replacement_time(self, now):
        return self._eol_time

    def finish(self):
        t = self._replacement_time(float(HORIZON_YEARS))
        if t is not None and t < HORIZON_YEARS - 1e-6:
            self.installs.append(t)
            self._eol_time = None

    def end_year(self, y, soc_fraction, annual_cycles, start_fraction=None):
        soc = np.clip(np.asarray(soc_fraction, dtype=float), 0.0, 1.0)
        soc = np.round(soc, FADE_SOC_DECIMALS)
        if start_fraction is not None:
            soc = np.append(start_fraction, soc)
        else:
            soc = np.append(soc, soc[-1])
        t_secs = np.arange(len(soc)) * 3600.0
        temp   = np.full(len(soc), FADE_TEMPERATURE_C)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            with np.errstate(all="ignore"):
                idx_turning_point = np.unique(np.array([cycle[-1] for cycle in blast_extract_cycles(soc)]))
                efcs = np.cumsum(np.abs(np.ediff1d(soc, to_begin=0))) / 2
                breakpoints = self.cell._find_breakpoints(
                    t_secs, efcs, idx_turning_point, max_time_diff_s=86400, max_EFC_diff=1)
                if breakpoints == [] or breakpoints[-1] != len(t_secs) - 1:
                    breakpoints.append(len(t_secs) - 1)
                prior = 0
                for bp in breakpoints:
                    if bp <= prior:
                        continue
                    self.cell.update_battery_state(t_secs[prior:bp + 1], soc[prior:bp + 1], temp[prior:bp + 1])
                    prior = bp
                    if self._eol_time is None and not (self.q() >= FADE_EOL):
                        self._eol_time = float(y + t_secs[bp] / t_secs[-1])
        st = self.cell.states
        loss_time  = sum(float(v[-1]) for k, v in st.items() if k.startswith('qLoss') and k.endswith('_t'))
        loss_cycle = sum(float(v[-1]) for k, v in st.items() if k.startswith('qLoss') and not k.endswith('_t'))
        self.rows.append([STUDY_START_YEAR + y, len(self.installs), self._q_start, self.q(),
                          loss_time, loss_cycle, annual_cycles,
                          float(soc[0]), float(soc[-1])])


