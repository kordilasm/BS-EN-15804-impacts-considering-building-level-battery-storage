        cycle_years = CYCLE_YEARS
    else:
        file_name = f"batch_optimization_{chem_prefix}{electricity_scenario}_future_{weather.upper()}{tag}.xlsx"
        cycle_years = CYCLE_YEARS_FUT
    cycle_year_cols = [f"Cycles {y}" for y in cycle_years]
    output_file = os.path.join("/Users/yourname/Downloads/", file_name)

    impacts_df = load_impacts_for_scenario(electricity_scenario)

    with pd.ExcelWriter(output_file, engine="openpyxl") as writer:


        for label in impact_labels:
            if label not in batch_results:
                continue

            results          = batch_results[label]
            all_test_results = results['all_test_results']

            all_data = []
            for test_num in range(25):
                if test_num not in all_test_results:
                    continue

                test_data    = all_test_results[test_num]
                capacity     = test_data['capacity_kWh']
                hours        = test_data['hours']
                operational_impacts = test_data['operational_all']

                cycles_by_year = test_data['cycles_by_year']
                installs       = test_data['install_times']
                if capacity > 0:
                    yearly = [cycles_by_year[min(y - STUDY_START_YEAR, len(cycles_by_year) - 1)]
                              for y in cycle_years]
                    repl = "; ".join(str(round(STUDY_START_YEAR + t)) for t in installs[1:]) or "none"
                    cycle_cols = [len(installs), repl] + yearly
                else:
                    cycle_cols = [0, ""] + [0] * len(cycle_years)

                all_data.append([
                    f"{hours:.0f} hours ({capacity:.1f} kWh)", "Impact Category",
                    "Operational Impact (60 years)", "Embodied Impact (60 years)",
                    "A1-A3 (60 years)", "A4 (60 years)", "B4 (60 years)", "C (60 years)",
                    "D (60 years)",
                    "Batteries needed", "Replacement years", *cycle_year_cols,
                ])

                for impact_label in labels:
                    if capacity > 0:
                        mods = test_data['embodied_modules']
                        embodied_value = mods['total'].get(impact_label, 0)
                        a1a3_value     = mods['A1A3'].get(impact_label, 0)
                        a4_value       = mods['A4'].get(impact_label, 0)
                        b4_value       = mods['B4'].get(impact_label, 0)
                        c_value        = mods['C'].get(impact_label, 0)
                    else:
                        embodied_value = 0
                        a1a3_value     = 0
                        a4_value       = 0
                        b4_value       = 0
                        c_value        = 0

                    d_value = test_data['module_d'][impact_label]

                    all_data.append(["", impact_label, operational_impacts[impact_label],
                                         embodied_value, a1a3_value, a4_value, b4_value, c_value,
                                         d_value] + cycle_cols)

                all_data.append([""] * (11 + len(cycle_years)))

            sheet_name = label[:31]
            df_sheet = pd.DataFrame(
                all_data,
                columns=[
                    'Capacity',
                    'Impact Category',
                    'Operational Impact (60 years)',
                    'Embodied Impact (60 years)',
                    'A1-A3 (60 years)',
                    'A4 (60 years)',
                    'B4 (60 years)',
                    'C (60 years)',
                    'D (60 years)',
                    'Batteries needed',
                    'Replacement years',
                    *cycle_year_cols
                ]
            )
            df_sheet.to_excel(writer, sheet_name=sheet_name, index=False)

        summary_data = []
        for label in impact_labels:
            if label in batch_results:
                r   = batch_results[label]
                opt = r['optimal_capacity']
                summary_data.append({
                    'Impact Category':          label,
                    'Optimal Capacity (kWh)':   opt,
                    'Storage Duration (hours)': opt / avg_demand_current if opt > 0 else 0,
                    'Annual Cycles':            r['cycles'] if r['cycles'] > 0 else 0
                })
        pd.DataFrame(summary_data).to_excel(writer, sheet_name="Summary", index=False)

    fade_rows = []
    for label in impact_labels:
        if label not in batch_results:
            continue
        for test_data in batch_results[label]['all_test_results'].values():
            for row in test_data['fade_rows']:
                fade_rows.append([label, test_data['capacity_kWh'], test_data['hours']] + row)
    fade_file = output_file.replace(".xlsx", "_fade_details.xlsx")
    pd.DataFrame(fade_rows, columns=['Impact category optimised', 'Capacity (kWh)',
                 'Hours of avg demand'] + FADE_DETAIL_COLUMNS
                 ).to_excel(fade_file, sheet_name="Capacity fade", index=False)

    return output_file


def get_battery_chemistry_choice():
    names = list(BATTERY_CHEMISTRIES.keys())
    while True:
        print("\nSelect battery chemistry:")
        for i, n in enumerate(names, 1):
            print(f"{i}. {n}")
        choice = input(f"Enter choice (1-{len(names)}): ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(names):
            return names[int(choice) - 1]


def get_weather_choice():
    while True:
        print("\nSelect weather case(s):")
        print("1. Current weather")
        print("2. Future weather (MEDIUM and/or HIGH)")
        print("3. Current and future weather")
        choice = input("Enter choice (1-3): ").strip()
        if choice in ("1", "2", "3"):
            break
    if choice == "1":
        return ["current"]
    future = {"1": ["medium"], "2": ["high"], "3": ["medium", "high"]}
    while True:
        print("\nSelect future weather:")
        print("1. MEDIUM")
        print("2. HIGH")
        print("3. MEDIUM and HIGH")
        sub = input("Enter choice (1-3): ").strip()
        if sub in future:
            break
    return (["current"] if choice == "3" else []) + future[sub]


def get_solver_options_choice():
    while True:
        c = input("Use solver time limits and optimality gap? (yes/no): ").strip().lower()
        if c in ('yes', 'y', 'no', 'n'):
            return c in ('yes', 'y')


def get_scenario_selection():
    print("\nSelect electricity scenario(s) for optimisation:")
    for idx, s in enumerate(["BASELINE", "FS", "ST", "CT", "LW", "ALL SCENARIOS"], 1):
        print(f"{idx}. {s}")
    print("\nYou can enter multiple numbers separated by commas (e.g., 1,3,5)")

    all_scenarios = ["BASELINE", "FS", "ST", "CT", "LW"]

    while True:
        try:
            user_input = input("Enter selection(s): ").strip()
            if user_input == "6":
                return "ALL", all_scenarios.copy()
            selections = [s.strip() for s in user_input.split(",")]
            chosen = []
            valid  = True
            for sel in selections:
                if not sel.isdigit() or not (1 <= int(sel) <= 5):
                    valid = False
                    break
                name = all_scenarios[int(sel) - 1]
                if name not in chosen:
                    chosen.append(name)
            if valid and chosen:
                label = chosen[0] if len(chosen) == 1 else f"SELECTED_{len(chosen)}"
                return label, chosen
        except ValueError:
            pass


def main():
    set_battery_chemistry(get_battery_chemistry_choice())
