def calculate_embodied_impacts(battery_mass: float, scenario: str,
                                      battery_lifetime_years: float, install_times=None,
                                      inverter_kw: float = 0.0) -> dict:
    if install_times is None:
        batteries_needed = math.ceil(round(60 / battery_lifetime_years, 9))
        install_times = [k * battery_lifetime_years for k in range(batteries_needed)]
    batteries_needed = len(install_times)

    total    = {label: 0.0 for label in labels}
    mod_a1a3 = {label: 0.0 for label in labels}
    mod_a4   = {label: 0.0 for label in labels}
    mod_b4   = {label: 0.0 for label in labels}
    mod_c    = {label: 0.0 for label in labels}

    for n in range(1, batteries_needed + 1):
        installation_year = round(STUDY_START_YEAR + install_times[n - 1])
        replacement_year  = round(STUDY_START_YEAR + (install_times[n] if n < batteries_needed else 60))
        c_year = STUDY_END_YEAR if n == batteries_needed else replacement_year

        if n == 1:
            for label in labels:
                a1a3_val = battery_mass * a1a3_factors[label]
                mod_a1a3[label] += a1a3_val
                total[label]    += a1a3_val

        for i, label in enumerate(labels):
            ship = battery_mass * a4_ship_baseline[i] * (10000 / 1000)
            if scenario == "BASELINE":
                road = battery_mass * a4_road_factors_baseline[i] * (500 / 1000)
            else:
                a4_road_per_kg = _get_future_module_per_kg(installation_year, scenario, "A4")
                road = battery_mass * a4_road_per_kg.get(label, 0) * (500 / 1000)

            mod_a4[label] += ship + road
            total[label]  += ship + road

        if n < batteries_needed:
            if scenario == "BASELINE":
                for i, label in enumerate(labels):
                    b4_val = battery_mass * b4_factors["BASELINE"][i]
                    mod_b4[label] += b4_val
                    total[label]  += b4_val
            else:
                b4_per_kg = _get_future_module_per_kg(replacement_year, scenario, "B4")
                for label in labels:
                    b4_val = battery_mass * b4_per_kg.get(label, 0)
                    mod_b4[label] += b4_val
                    total[label]  += b4_val

        if scenario == "BASELINE":
            for i, label in enumerate(labels):
                c_val = battery_mass * c_factors["BASELINE"][i]
                mod_c[label] += c_val
                total[label] += c_val
        else:
            c_per_kg = _get_future_module_per_kg(c_year, scenario, "C")
            for label in labels:
                c_val = battery_mass * c_per_kg.get(label, 0)
                mod_c[label] += c_val
                total[label] += c_val

    if inverter_kw and inverter_kw > 0:
        units    = inverter_kw / INVERTER_REF_KW
        inv_mass = units * INVERTER_REF_KG
        inv_times = [k * INVERTER_LIFETIME_YRS
                     for k in range(math.ceil(round(60 / INVERTER_LIFETIME_YRS, 9)))]
        n_inv = len(inv_times)
        for n in range(1, n_inv + 1):
            installation_year = round(STUDY_START_YEAR + inv_times[n - 1])
            replacement_year  = round(STUDY_START_YEAR + (inv_times[n] if n < n_inv else 60))
            c_year = STUDY_END_YEAR if n == n_inv else replacement_year

            if n == 1:
                for i, label in enumerate(labels):
                    v = units * inverter_a1a3_per_unit[i]
                    mod_a1a3[label] += v
                    total[label]    += v

            for i, label in enumerate(labels):
                ship = inv_mass * a4_ship_baseline[i] * (10000 / 1000)
                if scenario == "BASELINE":
                    road = inv_mass * a4_road_factors_baseline[i] * (500 / 1000)
                else:
                    a4_road_per_kg = _get_future_module_per_kg(installation_year, scenario, "A4")
                    road = inv_mass * a4_road_per_kg.get(label, 0) * (500 / 1000)
                mod_a4[label] += ship + road
                total[label]  += ship + road

            if n < n_inv:
                if scenario == "BASELINE":
                    for i, label in enumerate(labels):
                        v = units * inverter_b4_baseline_per_unit[i]
                        mod_b4[label] += v
                        total[label]  += v
                else:
                    b4_per_unit = _get_future_module_per_kg(replacement_year, scenario, "B4_inverter")
                    for label in labels:
                        v = units * b4_per_unit.get(label, 0)
                        mod_b4[label] += v
                        total[label]  += v

            if scenario == "BASELINE":
                for i, label in enumerate(labels):
                    v = units * inverter_c_baseline_per_unit[i]
                    mod_c[label] += v
                    total[label] += v
            else:
                c_per_unit = _get_future_module_per_kg(c_year, scenario, "C_inverter")
                for label in labels:
                    v = units * c_per_unit.get(label, 0)
                    mod_c[label] += v
                    total[label] += v

    return {
        'total': total,
        'A1A3':  mod_a1a3,
        'A4':    mod_a4,
        'B4':    mod_b4,
        'C':     mod_c,
    }


